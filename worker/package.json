{
  "name": "@housecup/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "db:migrate:local": "wrangler d1 migrations apply housecup --local",
    "db:seed:local": "wrangler d1 execute housecup --local --file=seed/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply housecup --remote",
    "db:seed:remote": "wrangler d1 execute housecup --remote --file=seed/seed.sql",
    "predev": "node scripts/ensure-assets.mjs",
    "pretest": "node scripts/ensure-assets.mjs",
    "db:reset:local": "node -e \"require('fs').rmSync('.wrangler/state',{recursive:true,force:true})\" && npm run db:migrate:local && npm run db:seed:local"
  },
  "dependencies": {
    "@housecup/shared": "0.1.0",
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.21",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.1",
    "@cloudflare/workers-types": "5.20261124.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.167.0"
  }
}
