{
  "name": "housecup-live",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "worker",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w worker",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "npm run test -w worker",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w worker && npm run typecheck -w web",
    "deploy": "npm run build && npm run deploy -w worker"
  },
  "allowScripts": {
    "workerd@1.20261123.1": true,
    "esbuild@0.28.2": true
  }
}
